# ============================================================================
# OANDA Trading Bot Configuration
# ============================================================================
# Copy this file to .env and fill in your actual credentials
# NEVER commit your .env file to git!
# ============================================================================

# ----------------------------------------------------------------------------
# OANDA API Credentials (REQUIRED)
# ----------------------------------------------------------------------------
# Get these from: https://www.oanda.com/account/tpa/personal_token
# Practice account: https://www.oanda.com/demo-account/tpa/personal_token

OANDA_API_KEY=your_api_key_here
OANDA_ACCOUNT_ID=your_account_id_here

# ----------------------------------------------------------------------------
# Notification Settings (OPTIONAL - choose one or both)
# ----------------------------------------------------------------------------

# --- SMS Notifications via Twilio ---
# Free trial: $15 credit (~500 messages)
# Cost after trial: ~$0.01 per SMS
# Sign up: https://www.twilio.com/try-twilio
# Find credentials: https://console.twilio.com/

TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_auth_token_here
TWILIO_FROM_NUMBER=+1234567890
TWILIO_TO_NUMBER=+1234567890

# --- Telegram Notifications (Recommended - 100% FREE) ---
# 1. Create bot: Message @BotFather on Telegram, send /newbot
# 2. Get Chat ID: Message @userinfobot on Telegram
# More info: See NOTIFICATIONS_SETUP.md

TELEGRAM_BOT_TOKEN=123456789:ABCdefGHIjklMNOpqrsTUVwxyz
TELEGRAM_CHAT_ID=123456789

# ============================================================================
# Notes:
# ============================================================================
# - Bot works fine without notifications (just remove/comment out above)
# - You can use SMS only, Telegram only, or both
# - Telegram is recommended (free, unlimited messages)
# - Make sure phone numbers include country code (e.g., +1 for US)
# - Test notifications with: python notification_service.py
# ============================================================================
